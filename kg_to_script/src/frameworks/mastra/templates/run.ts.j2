import { {% for wf in workflows %}{{ wf.var_name }}{% if not loop.last %}, {% endif %}{% endfor %} } from "./src/mastra/workflows"

// Node 20.6+ built-in .env loader - avoids needing the `dotenv` package,
// which isn't in this project's package.json.
try {
  process.loadEnvFile(".env")
} catch {
  // no .env file present; rely on already-exported env vars instead
}

async function main() {
{% for wf in workflows %}
  console.log("\n" + "=".repeat(80))
  console.log("Workflow: {{ wf.var_name }}")
  console.log("=".repeat(80))

  const run{{ loop.index }} = await {{ wf.var_name }}.createRunAsync()
  const result{{ loop.index }} = await run{{ loop.index }}.start({
    inputData: {
{% for field in wf.seed_fields %}
      {{ field }}: "",
{% endfor %}
{% if not wf.seed_fields %}
      input: "",
{% endif %}
    },
  })

  if (result{{ loop.index }}.status === "success") {
    console.log(result{{ loop.index }}.result)
  } else if (result{{ loop.index }}.status === "failed") {
    console.error(result{{ loop.index }}.error)
  } else {
    console.log(result{{ loop.index }})
  }
{% endfor %}
}

main()
