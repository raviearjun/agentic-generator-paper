from autogen_agentchat.agents import AssistantAgent

from autogen_agentchat.teams import {{ team_type }}

from autogen_agentchat.conditions import (
    MaxMessageTermination,
    TextMentionTermination,
)

from autogen_core.tools import FunctionTool

from autogen_ext.models.openai import (
    OpenAIChatCompletionClient
)

model_client = OpenAIChatCompletionClient(
    model="{{ model_name }}"
)

# ==================================================
# Generated Tool Stubs
# ==================================================

{% for tool in tool_defs %}

def {{ tool.var_name }}_impl(
    query: str = ""
) -> str:
    """
    AgentO Tool:
    {{ tool.class_name }}

    Description:
    {{ tool.description }}
    """
    return (
        "Tool '{{ tool.var_name }}' "
        "is a generated stub and "
        "has not been implemented yet."
    )


{{ tool.var_name }} = FunctionTool(
    {{ tool.var_name }}_impl,
    description="{{ tool.description }}"
)

{% endfor %}

# ==================================================
# Agents
# ==================================================

{% for agent in project.agents %}

{{ agent.var_name }} = AssistantAgent(
    name="{{ agent.var_name if agent.var_name else agent.agent_id|replace('-', '_') }}",
    model_client=model_client,
    system_message="""
Role:
{{ agent.role }}

Goal:
{{ agent.goal }}

Background:
{{ agent.backstory }}
""",
{% if agent.tool_var_names %}
    tools=[
{% for tool_name in agent.tool_var_names %}
        {{ tool_name }},
{% endfor %}
    ],
{% endif %}
)

{% endfor %}

termination_condition = MaxMessageTermination(
    max_messages={{ termination.max_messages if termination else 20 }}
)

{% if termination and termination.text_mention %}
termination_condition |= TextMentionTermination(
    "{{ termination.text_mention }}"
)
{% endif %}

{% if workflow_tree %}

{# Macro to build a team for a workflow pattern node #}
{% macro build_team(node) %}
{% set pattern = node.pattern %}
{% set team_name = pattern.label|default(pattern.name)|replace(' ', '_')|replace('-', '_')|lower %}
{{ team_name }}_termination = MaxMessageTermination(
    max_messages={{ (node.tasks|length * 2) + 2 if node.tasks else 4 }}
)
{{ team_name }}_team = {{ team_type }}(
    participants=[
{% for agent in project.agents %}
{% if agent.var_name in node.agents %}
        {{ agent.var_name }},
{% endif %}
{% endfor %}
    ],
    termination_condition={{ team_name }}_termination,
)
{% for child in node.children %}
{{ build_team(child) }}
{% endfor %}
{% endmacro %}

{# Build all teams for each workflow root and its descendants #}
{% for root in workflow_tree %}
{{ build_team(root) }}
{% endfor %}

workflow_tree = {
{% for iri, meta in pattern_metadata.items() %}
    "{{ iri }}": {
        "team": {{ pattern_map[iri].label|default(pattern_map[iri].name)|replace(' ', '_')|replace('-', '_')|lower }}_team,
        "prompt": """{{ meta.prompt|replace('"""','\\"\\"\\"') }}""",
        "agents": [
{% for agent in meta.agents %}
            "{{ agent }}",
{% endfor %}
        ],
    },
{% endfor %}
}

team = {{ workflow_tree[0].pattern.label|default(workflow_tree[0].pattern.name)|replace(' ', '_')|replace('-', '_')|lower }}_team

{% else %}

team = {{ team_type }}(
    participants=[
{% for agent in project.agents %}
        {{ agent.var_name }},
{% endfor %}
    ],
    termination_condition=termination_condition,
)

{% endif %}

{% if not workflow_tree %}
{% if ordered_tasks %}
TASK_PROMPT = """{{ ordered_tasks[0].description }}

Expected output: {{ ordered_tasks[0].expected_output }}
"""
{% else %}
TASK_PROMPT = """Begin."""
{% endif %}
{% endif %}