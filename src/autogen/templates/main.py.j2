import asyncio

from team import *



INPUTS = {

{% for var in input_variables %}

    "{{ var.name }}":
{% if var.has_default %}
        "{{ var.default_value }}",
{% else %}
        "",
{% endif %}

{% endfor %}
}


async def main():

    {% if not workflow_tree %}

    {% if input_variables %}
    task = TASK_PROMPT.format(**INPUTS)
    {% else %}
    task = TASK_PROMPT
    {% endif %}

    {% endif %}

    {% if not workflow_tree %}
    print("\n" + "=" * 80)
    print("TASK")
    print("=" * 80)
    print(task)
    {% endif %}

    print("\n" + "=" * 80)
    print("STREAM")
    print("=" * 80)



    try:

        {% if workflow_tree %}

        for pattern_name, pattern in workflow_tree.items():

            print("\n" + "=" * 80)
            print(f"WORKFLOW PATTERN: {pattern_name}")
            print(pattern["prompt"])
            print("=" * 80)

            async for msg in pattern["team"].run_stream(
                task=pattern["prompt"]
            ):
                print("\n" + "-" * 60)
                print(type(msg).__name__)

                if hasattr(msg, "source"):
                    print(f"SOURCE: {msg.source}")

                if hasattr(msg, "content"):
                    print(msg.content)
                else:
                    print(msg)

        {% else %}

        async for msg in team.run_stream(
            task=task
        ):
            print("\n" + "-" * 60)
            print(type(msg).__name__)

            if hasattr(msg, "source"):
                print(f"SOURCE: {msg.source}")

            if hasattr(msg, "content"):
                print(msg.content)
            else:
                print(msg)

        {% endif %}

        print("\n" + "=" * 80)
        print("DONE")
        print("=" * 80)

    except Exception as e:

        print("\n" + "=" * 80)
        print("ERROR")
        print("=" * 80)

        print(type(e).__name__)
        print(str(e))


if __name__ == "__main__":
    asyncio.run(main())